---
// Title (h3) and subtitle shared by both ProjectCard variants. The link's
// ::after covers the whole card (whole-card link).
import type { Project } from '../lib/catalogue/core';
import type { Locale } from '../i18n';
import Link from './Link.astro';

interface Props {
  project: Project;
  locale: Locale;
  titleClass: string;
}
const { project, locale, titleClass } = Astro.props;
---

<div class="flex flex-col gap-2">
  <h3
    class:list={[
      'font-display leading-(--leading-display) font-semibold tracking-(--tracking-display)',
      titleClass,
    ]}
  >
    <Link
      href={project.primaryLink.url}
      locale={locale}
      bare
      iconOnly
      class="after:absolute after:inset-0 after:content-['']"
    >
      {project.title}
    </Link>
  </h3>
  <p class="font-mono text-sm text-text-muted">{project.subtitle}</p>
</div>
