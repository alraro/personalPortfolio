---
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import ThemeHead from '../components/ThemeHead.astro';
import { locales, switchLocalePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://alfonsoramos.dev');
const absolute = (path: string) => new URL(path, site).href;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={absolute(pathname)} />
    {locales.map((target) => (
      <link
        rel="alternate"
        hreflang={target}
        href={absolute(switchLocalePath(pathname, target))}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://alfonsoramos.dev/"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
