<script>
  function showTokenValues() {
    const style = getComputedStyle(document.documentElement);
    document
      .querySelectorAll<HTMLElement>('[data-token-value]')
      .forEach((el) => {
        el.textContent = style
          .getPropertyValue(el.dataset.tokenValue ?? '')
          .trim();
      });
  }
  showTokenValues();
  new MutationObserver(showTokenValues).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });

  const demo = document.querySelector('[data-motion-demo]');
  let moved = false;
  demo?.querySelector('[data-motion-play]')?.addEventListener('click', () => {
    moved = !moved;
    demo.querySelectorAll<HTMLElement>('[data-motion-dot]').forEach((dot) => {
      const track = dot.parentElement;
      const distance = (track?.clientWidth ?? 0) - dot.clientWidth;
      dot.style.transform = moved ? `translateX(${distance}px)` : '';
    });
  });
</script>
