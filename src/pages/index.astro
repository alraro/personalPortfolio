---
import '../styles/global.css';
import ThemeHead from '../components/ThemeHead.astro';
import { t } from '../i18n';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <title>Alfonso Ramos Rojas</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <meta name="robots" content="noindex" />
    <noscript>
      <meta http-equiv="refresh" content="0; url=/en/" />
    </noscript>
  </head>
  <body class="flex min-h-screen items-center justify-center">
    <main>
      <ul class="flex gap-4">
        <li>
          <a href="/en/" hreflang="en" lang="en" class="underline">
            {t('en', 'language.en.name')}
          </a>
        </li>
        <li>
          <a href="/es/" hreflang="es" lang="es" class="underline">
            {t('es', 'language.es.name')}
          </a>
        </li>
      </ul>
    </main>
    <script>
      import { decideLocale, LANG_STORAGE_KEY } from '../i18n/locale';

      let stored: string | null = null;
      try {
        stored = localStorage.getItem(LANG_STORAGE_KEY);
      } catch {
        // Storage may be unavailable.
      }
      const languages = navigator.languages?.length
        ? navigator.languages
        : [navigator.language];
      location.replace(`/${decideLocale(stored, languages)}/`);
    </script>
  </body>
</html>
