---
import { locales, switchLocalePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = locales.map((target) => ({
  target,
  href: switchLocalePath(Astro.url.pathname, target),
  short: t(locale, `language.${target}.short`),
  name: t(locale, `language.${target}.name`),
  current: target === locale,
}));
---

<nav aria-label={t(locale, 'language.switchLabel')}>
  <ul class="flex gap-3">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          hreflang={item.target}
          lang={item.target}
          aria-current={item.current ? 'true' : undefined}
          data-lang-choice={item.target}
          class="rounded px-1 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 aria-[current=true]:font-bold"
        >
          <span aria-hidden="true">{item.short}</span>
          <span class="sr-only">{item.name}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { LANG_STORAGE_KEY } from '../i18n/locale';

  document
    .querySelectorAll<HTMLAnchorElement>('a[data-lang-choice]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        try {
          localStorage.setItem(LANG_STORAGE_KEY, link.dataset.langChoice ?? '');
        } catch {
          // Storage may be unavailable; the switch still navigates.
        }
      });
    });
</script>
