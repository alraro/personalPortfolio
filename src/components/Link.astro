---
import { isExternalHref } from '../lib/links';
import { t, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  href: string;
  locale: Locale;
  class?: string;
}

const { href, locale, class: className, ...rest } = Astro.props;
const site = Astro.site?.href ?? 'https://alfonsoramos.dev';
const external = isExternalHref(href, site);
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'text-accent underline decoration-1 underline-offset-4 transition-colors duration-(--duration-fast) ease-(--ease-standard) hover:decoration-2',
    className,
  ]}
  {...rest}
>
  <slot />
  {external && (
    <>
      <Icon
        name="ExternalLink"
        class="ml-1 inline align-[-0.1em] text-[0.85em]"
      />
      <span class="sr-only">{t(locale, 'link.opensInNewTab')}</span>
    </>
  )}
</a>
