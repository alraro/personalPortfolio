---
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import LocaleLayout from '../../layouts/LocaleLayout.astro';
import { locales, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const name = 'Alfonso Ramos Rojas';
---

<LocaleLayout locale={locale} title={name}>
  <header class="flex justify-end p-4">
    <LanguageSwitch locale={locale} />
  </header>
  <main class="flex flex-col items-center justify-center gap-2 pt-24">
    <h1 class="text-4xl font-bold">{name}</h1>
    <p class="text-neutral-400">{t(locale, 'home.comingSoon')}</p>
  </main>
</LocaleLayout>
