---
import { getEvents } from '../lib/catalogue';
import { t, type Locale } from '../i18n';
import EventRow from './EventRow.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const events = await getEvents(locale);
---

{events.length > 0 && (
  <section
    aria-labelledby="events"
    class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-16"
  >
    <SectionHeading id="events">{t(locale, 'events.heading')}</SectionHeading>
    <ul>
      {events.map((event) => (
        <EventRow event={event} locale={locale} />
      ))}
    </ul>
  </section>
)}
