---
import { t, type Locale } from '../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  /** About text, already rendered from Markdown. */
  html: string;
}

const { locale, html } = Astro.props;
---

<section
  aria-labelledby="about"
  class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-16"
>
  <SectionHeading id="about">{t(locale, 'about.heading')}</SectionHeading>
  <div
    class="max-w-[65ch] text-lg leading-relaxed text-text [&_p+p]:mt-4"
    set:html={html}
  />
</section>
