---
// One wrapper for the two allowed icon sources:
//  - Lucide (general icons): name is the PascalCase Lucide name, e.g. "Sun".
//  - Simple Icons (brands): name is the Simple Icons key without "si", e.g. "Github".
//  - Custom (brands neither library ships): name is a key of src/lib/custom-icons.ts.
import { icons as lucideIcons } from 'lucide';
import * as simpleIcons from 'simple-icons';
import { customIcons, type CustomIconName } from '../lib/custom-icons';

interface Props {
  source?: 'lucide' | 'simple' | 'custom';
  name: string;
  /** Accessible name. Without it the icon is decorative (aria-hidden). */
  label?: string;
  class?: string;
}

const { source = 'lucide', name, label, class: className } = Astro.props;

const lucideNode =
  source === 'lucide'
    ? lucideIcons[name as keyof typeof lucideIcons]
    : undefined;
const brand =
  source === 'simple'
    ? (simpleIcons as unknown as Record<string, { path: string } | undefined>)[
        `si${name}`
      ]
    : undefined;

const customPath =
  source === 'custom' ? customIcons[name as CustomIconName] : undefined;

if (!lucideNode && !brand && !customPath) {
  throw new Error(`Unknown ${source} icon "${name}"`);
}
---

{brand || customPath ? (
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    class:list={['size-[1em] shrink-0', className]}
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    focusable="false"
  >
    <path
      d={brand ? brand.path : customPath}
      fill-rule={brand ? undefined : 'evenodd'}
    />
  </svg>
) : (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={['size-[1em] shrink-0', className]}
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    focusable="false"
  >
    {lucideNode!.map(([tag, attrs]) => {
      const Tag = tag as 'path';
      return <Tag {...attrs} />;
    })}
  </svg>
)}
